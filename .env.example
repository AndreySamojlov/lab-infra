# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=n8n

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<GRAFANA_PASSWORD>

# Google OAuth for Grafana access via oauth2-proxy
GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<secret>
OAUTH2_PROXY_GRAFANA_COOKIE_SECRET=<secret>
ALLOWED_EMAIL=<your-email@example.com>

# Server
SERVER_IP=<YOUR_SERVER_IP>

# n8n
N8N_ENCRYPTION_KEY=<key>

# n8n-mcp
N8N_MCP_API_KEY=<n8n-api-key-from-settings-api>
N8N_MCP_AUTH_TOKEN=<generate-32-plus-char-random-token>
N8N_MCP_LOG_LEVEL=info
N8N_MCP_AUTH_RATE_LIMIT_WINDOW=900000
N8N_MCP_AUTH_RATE_LIMIT_MAX=300
